# Chế độ gọi model: omniroute (qua cổng) hoặc direct (thẳng vào Ollama, không cần khoá cloud)
LLM_MODE=omniroute
LLM_BASE_URL=http://localhost:20128/v1
# Khoá của cổng OmniRoute nếu bạn bật REQUIRE_API_KEY (KHÔNG ghi khoá nhà cung cấp cloud vào đây)
LLM_API_KEY=not-needed
OLLAMA_URL=http://localhost:11434
OMNIROUTE_URL=http://localhost:20128
# Dùng khi LLM_MODE=direct: ánh xạ combo -> model Ollama
DIRECT_MODEL_BRAIN=studio-gemma4-12b
DIRECT_MODEL_CODER=studio-gemma4-12b
DIRECT_MODEL_FAST=studio-qwen3-4b
DIRECT_MODEL_VISION=studio-gemma4-12b
